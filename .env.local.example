# ESPN Fantasy Football league to connect to.
# From your league URL: https://fantasy.espn.com/football/team?leagueId=856864482
ESPN_LEAGUE_ID=856864482

# Season year the draft is happening in.
ESPN_SEASON_YEAR=2026

# Required ONLY for private leagues (most leagues are private by default).
# Public data (players, news) works without these, but you won't get your
# league's real roster settings, scoring, or live draft picks until these
# are set.
#
# How to get them:
# 1. Log into fantasy.espn.com in your browser.
# 2. Open DevTools -> Application/Storage -> Cookies -> fantasy.espn.com
# 3. Copy the values of the "espn_s2" and "SWID" cookies (SWID includes the
#    curly braces, e.g. {ABCD1234-...}).
# These are read server-side only (in API routes) and are never sent to the
# browser or committed to git.
ESPN_S2=
ESPN_SWID=
